# ==============================================================================
# Modular File Manager - Environment Configuration (Docker Compose)
# ==============================================================================
# Copy this file to .env and configure with your actual values
# SECURITY: Never commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=filemanager
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=filemanager
# IMPORTANT: Use internal Docker network hostname and port
# Inside Docker, PostgreSQL always runs on port 5432
# Host port mapping (e.g., 45432:5432) is configured in docker-compose.yml
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database connection URL (auto-constructed from above values)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Database pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
REDIS_PASSWORD=changeme_redis_password
# IMPORTANT: Use internal Docker network hostname and port
# Inside Docker, Redis always runs on port 6379
# Host port mapping (e.g., 46379:6379) is configured in docker-compose.yml
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_MAX_CONNECTIONS=50

# ------------------------------------------------------------------------------
# Elasticsearch Configuration (for search & indexing)
# ------------------------------------------------------------------------------
# Enable/disable Elasticsearch integration
ELASTICSEARCH_ENABLED=true

# Elasticsearch connection URL
# Docker Compose: http://elasticsearch:9200 (internal network, no auth)
# Standalone: http://localhost:9200
ELASTICSEARCH_URL=http://elasticsearch:9200

# Optional authentication (leave empty if not needed for Docker internal network)
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Index names (auto-created if not exist)
ELASTICSEARCH_INDEX_OPERATIONS=rfm-operations
ELASTICSEARCH_INDEX_FILES=rfm-files

# Connection settings
ELASTICSEARCH_MAX_RETRIES=3
ELASTICSEARCH_TIMEOUT=30

# ------------------------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------------------------
# Secret key for JWT token signing (HS256)
# CRITICAL: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_BYTE_STRING_MINIMUM_32_CHARS

# JWT token expiration
ACCESS_TOKEN_EXPIRE_DAYS=30

# API server settings (internal Docker network)
# IMPORTANT: API_PORT is the port INSIDE the container (always 8000)
# API_HOST_PORT is the port exposed to YOUR machine (can be customized)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# API host ports (exposed to host machine)
# These are the ports you'll use to access the API from outside Docker
# Format: <host_port>:<container_port> in docker-compose.yml
API_HOST_PORT=8000
API_HOST_PORT_HTTPS=8443

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# WebUI Configuration
# ------------------------------------------------------------------------------
# WebUI host port (exposed to host machine)
WEBUI_HOST_PORT=3000

# API URL (internal Docker network)
# IMPORTANT: Use the service name 'api' and internal port 8000
# This is used by the WebUI container to communicate with the API container
API_URL=http://api:8000

# API URL (public - for browser requests)
# IMPORTANT: This is the URL the browser uses to connect to the API
# Used by the browser to connect to the API from outside Docker
# Examples:
#   - http://localhost:8000 (if API_HOST_PORT=8000)
#   - http://localhost:48080 (if API_HOST_PORT=48080)
#   - http://192.168.1.100:8000 (for LAN access)
#   - https://api.ff.vitkac.local (if using reverse proxy with separate API domain)
# CRITICAL: If using a reverse proxy (nginx/traefik) with separate domains for
# webui and API (e.g., ff.vitkac.local → webui, api.ff.vitkac.local → API),
# you MUST set this to the API domain, otherwise WebSocket connections will fail!
API_URL_PUBLIC=http://localhost:8000
FRONTEND_URL_PUBLIC=http://localhost:3000

# Flask environment
FLASK_ENV=production
FLASK_DEBUG=false

# ------------------------------------------------------------------------------
# TLS/SSL Configuration
# ------------------------------------------------------------------------------
# TLS enabled (self-signed certificates generated automatically)
TLS_ENABLED=true
TLS_MIN_VERSION=1.3

# For production, mount real certificates:
# TLS_CERT_PATH=/etc/ssl/file-manager/cert.pem
# TLS_KEY_PATH=/etc/ssl/file-manager/key.pem

# ------------------------------------------------------------------------------
# Worker Configuration
# ------------------------------------------------------------------------------
WORKER_HEARTBEAT_INTERVAL=30
WORKER_HEARTBEAT_TIMEOUT=180
WORKER_TIMEOUT=300
WORKER_RETRY_ATTEMPTS=3

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Log level: debug, info, warning, error, critical (lowercase for uvicorn compatibility)
LOG_LEVEL=info
LOG_FORMAT=json
LOG_RETENTION_DAYS=14

# Structured logging
ENABLE_JSON_LOGS=true
ENABLE_FILE_LOGS=true

# ------------------------------------------------------------------------------
# External Integrations (Optional)
# ------------------------------------------------------------------------------
# PolkaSQL Authentication API (Sybase SQL Anywhere 17 - RFM_Auth WebService)
# Authenticate users against PolkaSQL/Sybase database via RFM_Auth API
# When enabled, users are authenticated remotely and created automatically in RFM
# IMPORTANT: Username and password are case-insensitive per PolkaSQL requirements
# Read-only mode - passwords cannot be changed in RFM, only verified on login
ENABLE_POLKA_AUTH=false
POLKA_AUTH_URL=http://polkaserver.local/RFM_Auth
POLKA_AUTH_API_KEY=
POLKA_AUTH_TIMEOUT=5

# Syslog Integration
ENABLE_SYSLOG=false
SYSLOG_HOST=
SYSLOG_PORT=514
SYSLOG_PROTOCOL=UDP
SYSLOG_FORMAT=RFC5424
SYSLOG_HOSTNAME=

# Remote Audit API
ENABLE_REMOTE_AUDIT_API=false
REMOTE_AUDIT_API_URL=
REMOTE_AUDIT_API_TOKEN=
REMOTE_AUDIT_API_TIMEOUT=5

# ROSAPI - Remote Operation Signalling API (PIM Integration)
# Signal external PIM system when PUSH/PULL operations complete
# Supports template variables in endpoints/payloads: {folder_name}, {operation_id}, {source_path}, {dest_path}
ENABLE_ROSAPI=false

# Authentication Settings
# ROSAPI_AUTH_BASE_URL: Base URL for authentication (defaults to ROSAPI_BASE_URL if not set)
# If your auth service is on a different domain, set this explicitly
ROSAPI_BASE_URL=
ROSAPI_AUTH_BASE_URL=
ROSAPI_AUTH_LOGIN_ENDPOINT=/api/v1/auth/login
ROSAPI_AUTH_REFRESH_ENDPOINT=/api/v1/auth/refresh
ROSAPI_AUTH_EMAIL=
ROSAPI_AUTH_PASSWORD=
ROSAPI_TIMEOUT=10

# PUSH Operation Signalling
# ROSAPI_PUSH_BASE_URL: Base URL for PUSH operations (defaults to ROSAPI_BASE_URL if not set)
ROSAPI_PUSH_ENABLED=true
ROSAPI_PUSH_BASE_URL=
ROSAPI_PUSH_ENDPOINT=/api/v1/products/tg/{folder_name}/set_image_catalog
ROSAPI_PUSH_METHOD=POST
ROSAPI_PUSH_PAYLOAD={"generate_thumbnails": false}

# PULL Operation Signalling
# ROSAPI_PULL_BASE_URL: Base URL for PULL operations (defaults to ROSAPI_BASE_URL if not set)
ROSAPI_PULL_ENABLED=false
ROSAPI_PULL_BASE_URL=
ROSAPI_PULL_ENDPOINT=
ROSAPI_PULL_METHOD=POST
ROSAPI_PULL_PAYLOAD={}

# Verification (Optional)
# ROSAPI_VERIFY_BASE_URL: Base URL for verification (defaults to ROSAPI_BASE_URL if not set)
ROSAPI_VERIFY_BASE_URL=
ROSAPI_VERIFY_ENDPOINT=

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
# Maximum concurrent authenticated users
MAX_CONCURRENT_USERS=30

# File operation settings
OPERATION_TIMEOUT=3600
ENABLE_AUTO_ROLLBACK=true
MAX_FILE_LISTING_ITEMS=1000

# Path prefixes (can be overridden per worker in DB)
GLOBAL_PATH_A_PREFIX=
GLOBAL_PATH_B_PREFIX=

# VF Redesign: Preset paths for PUSH/PULL operations
# PATH_B: Destination path for PUSH operations (admin-configurable)
# PATH_C: Archive path for PUSH operations (admin-configurable)
# IMPORTANT: These paths must be accessible by the worker
PATH_B=/path/to/destination
PATH_C=/path/to/archive

# PUSH operation behavior settings
ENABLE_PUSH_FLATTEN=false
ENABLE_PUSH_ARCHIVE=false
PUSH_IGNORE_FILE_MASKS=Thumbs.db

# ------------------------------------------------------------------------------
# Development / Testing
# ------------------------------------------------------------------------------
# Enable debug mode (NEVER in production!)
DEBUG=false

# Enable SQL query logging
SQL_ECHO=false

# Allow insecure connections (testing only)
ALLOW_INSECURE=false

# ------------------------------------------------------------------------------
# PIM - Product Information Manager signalling (second, independent target)
# ------------------------------------------------------------------------------
# Authenticates with a static X-API-TOKEN header (no JWT login flow).
# Fires on PUSH (created), PULL (updated) and UPDATE (updated).
#
# NOTE: every PIM / validation key below is synced from .env into the DB ONLY
# when the variable is actually present here. Leave one unset to let the Admin
# Panel own that value across restarts; set it to force a value on every boot.
ENABLE_PIM=false
PIM_BASE_URL=https://pim-api.vitkac.com
PIM_ENDPOINT=/api/v1/image_catalog/ftp_event
PIM_METHOD=POST
# Value sent in the X-API-TOKEN header
PIM_API_TOKEN=
PIM_TIMEOUT=10

# Per-operation toggles and the eventType each reports
PIM_PUSH_ENABLED=true
PIM_PUSH_EVENT_TYPE=created
PIM_PULL_ENABLED=true
PIM_PULL_EVENT_TYPE=updated
PIM_UPDATE_ENABLED=true
PIM_UPDATE_EVENT_TYPE=updated

# Request body template, fully editable in Admin Panel.
# Placeholders: {files} {catalog_name} {event_type} {tg_id}
#               {operation_id} {username} {source_path} {dest_path}
# {files} is substituted as a raw JSON array; the rest are JSON-escaped strings.
# {tg_id} is the product's tgId (Polka27.elementy.grup_nazwe), returned by
# RFM_ValidateProductName (CATALOG_VALIDATION_URL/API_KEY must be set).
PIM_PAYLOAD_TEMPLATE={"tgId": "{tg_id}", "imageCatalog": "{catalog_name}", "eventType": "{event_type}", "files": {files}}

# Delivery is queued and retried with exponential backoff: PIM_RETRY_BASE_SECONDS,
# doubling per failed attempt up to PIM_RETRY_MAX_DELAY_SECONDS. After
# PIM_RETRY_MAX_HOURS (0 = never) the event is marked failed; it can be retried
# from the operation details.
PIM_RETRY_BASE_SECONDS=10
PIM_RETRY_MAX_DELAY_SECONDS=600
PIM_RETRY_MAX_HOURS=72

# ------------------------------------------------------------------------------
# Image host synchronization verification (optional, off by default)
# ------------------------------------------------------------------------------
# After a PUSH, poll one URL per image file until every image is served (HTTP 200,
# image/* content type, non-empty body). Placeholders are URL-encoded:
# {catalog_name} {file} {tg_id}. Status shows in the operation history.
ENABLE_REMOTE_SYNC_CHECK=false
REMOTE_SYNC_CHECK_URL_TEMPLATE=https://img.vitkac.com/uploads/product_thumb/{catalog_name}/up/{file}
# Start the clock only once PIM has received the event
REMOTE_SYNC_CHECK_WAIT_FOR_PIM=true
REMOTE_SYNC_CHECK_INITIAL_DELAY_SECONDS=60
REMOTE_SYNC_CHECK_INTERVAL_SECONDS=120
REMOTE_SYNC_CHECK_TIMEOUT_MINUTES=180
REMOTE_SYNC_CHECK_REQUEST_TIMEOUT=15
# Unique query parameter per check; the CDN caches 404s and empty 200s
REMOTE_SYNC_CHECK_CACHE_BUST=true

# ------------------------------------------------------------------------------
# Catalog name validation (PolkaSQL RFM_ValidateProductName)
# ------------------------------------------------------------------------------
# Refuses PUSH/UPDATE when the catalog folder name does not match a product in
# Polka27.elementy.grup_nazwe_kolor. Suggestions are offered on a miss.
ENABLE_CATALOG_VALIDATION=false
CATALOG_VALIDATION_URL=
CATALOG_VALIDATION_API_KEY=
CATALOG_VALIDATION_TIMEOUT=5
CATALOG_VALIDATION_MAX_SUGGESTIONS=5
# Fail-closed by default: an unreachable PolkaSQL blocks the operation.
# Set true to let pushes through during a PolkaSQL outage.
CATALOG_VALIDATION_FAIL_OPEN=false

# ------------------------------------------------------------------------------
# Directory content validation for PUSH / UPDATE
# ------------------------------------------------------------------------------
# Requires at least PUSH_VALIDATION_MIN_FILES genuine image files. Non-image
# files do not count toward the minimum but are still sent to PIM.
PUSH_VALIDATION_ENABLED=true
PUSH_VALIDATION_MIN_FILES=2
PUSH_VALIDATION_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,bmp,tif,tiff,webp
# Verify the real file type from magic bytes, not just the extension
PUSH_VALIDATION_VERIFY_CONTENT=true
# Refuse a PUSH/UPDATE unless every file is named <number>.<extension>
# (e.g. 3.png), the only form PIM accepts. Files matching
# PUSH_IGNORE_FILE_MASKS (Thumbs.db) are not copied, so they are not checked.
ENABLE_PUSH_VALIDATION_FILE_NAMES=true

# ------------------------------------------------------------------------------
# UPDATE operation behaviour
# ------------------------------------------------------------------------------
# Mirror in-place UPDATE changes from PATH_B into the PATH_C archive copy.
# Off by default - the archive is not consumed downstream yet.
ENABLE_UPDATE_ARCHIVE_MIRROR=false

# Files uploaded through the WebUI to replace or add catalog files. They wait
# on the API host (volume at UPDATE_UPLOAD_DIR) until the worker fetches them,
# and are deleted as soon as the UPDATE finishes, or after the TTL if unused.
# UPDATE_UPLOAD_MAX_MB / UPDATE_UPLOAD_TTL_HOURS seed the Admin Panel values.
# UPDATE_UPLOAD_DIR=/var/lib/file-manager/uploads
# UPDATE_UPLOAD_MAX_MB=200
# UPDATE_UPLOAD_TTL_HOURS=24

# ------------------------------------------------------------------------------
# Initial Admin User (created at first startup)
# ------------------------------------------------------------------------------
# Default credentials - CHANGE AFTER FIRST LOGIN!
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123

# ==============================================================================
# Docker Compose Usage:
# ==============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and set secure passwords for:
#    - POSTGRES_PASSWORD
#    - REDIS_PASSWORD
#    - SECRET_KEY (generate with: openssl rand -base64 64)
# 3. Start services: docker-compose up -d
# 4. View logs: docker-compose logs -f
# 5. Access WebUI: http://localhost:3000
# 6. Login with: admin / admin123
# 7. IMMEDIATELY change admin password after first login!
# ==============================================================================
