# ==============================================================================
# Modular File Manager - Environment Configuration (Docker Compose)
# ==============================================================================
# Copy this file to .env and configure with your actual values
# SECURITY: Never commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=filemanager
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=filemanager
# IMPORTANT: Use internal Docker network hostname and port
# Inside Docker, PostgreSQL always runs on port 5432
# Host port mapping (e.g., 45432:5432) is configured in docker-compose.yml
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database connection URL (auto-constructed from above values)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Database pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
REDIS_PASSWORD=changeme_redis_password
# IMPORTANT: Use internal Docker network hostname and port
# Inside Docker, Redis always runs on port 6379
# Host port mapping (e.g., 46379:6379) is configured in docker-compose.yml
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_MAX_CONNECTIONS=50

# ------------------------------------------------------------------------------
# Elasticsearch Configuration (for search & indexing)
# ------------------------------------------------------------------------------
# Enable/disable Elasticsearch integration
ELASTICSEARCH_ENABLED=true

# Elasticsearch connection URL
# Docker Compose: http://elasticsearch:9200 (internal network, no auth)
# Standalone: http://localhost:9200
ELASTICSEARCH_URL=http://elasticsearch:9200

# Optional authentication (leave empty if not needed for Docker internal network)
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Index names (auto-created if not exist)
ELASTICSEARCH_INDEX_OPERATIONS=rfm-operations
ELASTICSEARCH_INDEX_FILES=rfm-files

# Connection settings
ELASTICSEARCH_MAX_RETRIES=3
ELASTICSEARCH_TIMEOUT=30

# ------------------------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------------------------
# Secret key for JWT token signing (HS256)
# CRITICAL: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_BYTE_STRING_MINIMUM_32_CHARS

# JWT token expiration
ACCESS_TOKEN_EXPIRE_DAYS=30

# API server settings (internal Docker network)
# IMPORTANT: API_PORT is the port INSIDE the container (always 8000)
# API_HOST_PORT is the port exposed to YOUR machine (can be customized)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# API host ports (exposed to host machine)
# These are the ports you'll use to access the API from outside Docker
# Format: <host_port>:<container_port> in docker-compose.yml
API_HOST_PORT=8000
API_HOST_PORT_HTTPS=8443

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# WebUI Configuration
# ------------------------------------------------------------------------------
# WebUI host port (exposed to host machine)
WEBUI_HOST_PORT=3000

# API URL (internal Docker network)
# IMPORTANT: Use the service name 'api' and internal port 8000
# This is used by the WebUI container to communicate with the API container
API_URL=http://api:8000

# API URL (public - for browser requests)
# IMPORTANT: This should match your API_HOST_PORT for HTTP access
# Used by the browser to connect to the API from outside Docker
# Examples:
#   - http://localhost:8000 (if API_HOST_PORT=8000)
#   - http://localhost:48080 (if API_HOST_PORT=48080)
#   - http://192.168.1.100:8000 (for LAN access)
API_URL_PUBLIC=http://localhost:8000

# Flask environment
FLASK_ENV=production
FLASK_DEBUG=false

# ------------------------------------------------------------------------------
# TLS/SSL Configuration
# ------------------------------------------------------------------------------
# TLS enabled (self-signed certificates generated automatically)
TLS_ENABLED=true
TLS_MIN_VERSION=1.3

# For production, mount real certificates:
# TLS_CERT_PATH=/etc/ssl/file-manager/cert.pem
# TLS_KEY_PATH=/etc/ssl/file-manager/key.pem

# ------------------------------------------------------------------------------
# Worker Configuration
# ------------------------------------------------------------------------------
WORKER_HEARTBEAT_INTERVAL=30
WORKER_HEARTBEAT_TIMEOUT=90
WORKER_TIMEOUT=300
WORKER_RETRY_ATTEMPTS=3

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Log level: debug, info, warning, error, critical (lowercase for uvicorn compatibility)
LOG_LEVEL=info
LOG_FORMAT=json
LOG_RETENTION_DAYS=14

# Structured logging
ENABLE_JSON_LOGS=true
ENABLE_FILE_LOGS=true

# ------------------------------------------------------------------------------
# External Integrations (Optional)
# ------------------------------------------------------------------------------
# PolkaSQL Authentication API (Sybase SQL Anywhere 17 - RFM_Auth WebService)
# Authenticate users against PolkaSQL/Sybase database via RFM_Auth API
# When enabled, users are authenticated remotely and created automatically in RFM
# IMPORTANT: Username and password are case-insensitive per PolkaSQL requirements
# Read-only mode - passwords cannot be changed in RFM, only verified on login
POLKA_AUTH_ENABLED=false
POLKA_AUTH_URL=http://polkaserver.local/RFM_Auth
POLKA_AUTH_API_KEY=
POLKA_AUTH_TIMEOUT=5

# Syslog Integration
ENABLE_SYSLOG=false
SYSLOG_HOST=
SYSLOG_PORT=514
SYSLOG_PROTOCOL=UDP

# Remote Audit API
ENABLE_REMOTE_AUDIT_API=false
REMOTE_AUDIT_API_URL=
REMOTE_AUDIT_API_TOKEN=
REMOTE_AUDIT_API_TIMEOUT=5

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
# Maximum concurrent authenticated users
MAX_CONCURRENT_USERS=4

# File operation settings
OPERATION_TIMEOUT=3600
ENABLE_AUTO_ROLLBACK=true
MAX_FILE_LISTING_ITEMS=1000

# Path prefixes (can be overridden per worker in DB)
GLOBAL_PATH_A_PREFIX=
GLOBAL_PATH_B_PREFIX=

# VF Redesign: Preset paths for PUSH/PULL operations
# PATH_B: Destination path for PUSH operations (admin-configurable)
# PATH_C: Archive path for PUSH operations (admin-configurable)
# IMPORTANT: These paths must be accessible by the worker
PATH_B=/path/to/destination
PATH_C=/path/to/archive

# ------------------------------------------------------------------------------
# Development / Testing
# ------------------------------------------------------------------------------
# Enable debug mode (NEVER in production!)
DEBUG=false

# Enable SQL query logging
SQL_ECHO=false

# Allow insecure connections (testing only)
ALLOW_INSECURE=false

# ------------------------------------------------------------------------------
# Initial Admin User (created at first startup)
# ------------------------------------------------------------------------------
# Default credentials - CHANGE AFTER FIRST LOGIN!
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123

# ==============================================================================
# Docker Compose Usage:
# ==============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and set secure passwords for:
#    - POSTGRES_PASSWORD
#    - REDIS_PASSWORD
#    - SECRET_KEY (generate with: openssl rand -base64 64)
# 3. Start services: docker-compose up -d
# 4. View logs: docker-compose logs -f
# 5. Access WebUI: http://localhost:3000
# 6. Login with: admin / admin123
# 7. IMMEDIATELY change admin password after first login!
# ==============================================================================
