<?xml version="1.0" encoding="utf-8"?>
<!--
  One version for every RFM component: <major.minor from VERSION>.<commits in HEAD>,
  e.g. 1.3.398. Every commit raises it, and promotion fast-forwards vf to dev-vf, so
  the server, worker, RFM Launcher, RFM Tray and the installer built from one commit
  all report the same version. backend/Dockerfile computes it the same way.

  Imported by the worker, Launcher and Tray projects (generates the assembly version)
  and by the installer project (defines $(var.RfmVersion) for Product.wxs).
  Raise VERSION by hand only for a new major.minor; the last part counts itself.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="RfmVersion" BeforeTargets="BeforeBuild">
    <Exec Command="git rev-list --count HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="RfmBuildNumber" />
    </Exec>
    <PropertyGroup>
      <RfmVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim()).$(RfmBuildNumber.Trim())</RfmVersion>
      <RfmVersionFile>$(IntermediateOutputPath)RfmVersion.g.cs</RfmVersionFile>
      <DefineConstants Condition="'$(MSBuildProjectExtension)' == '.wixproj'">$(DefineConstants);RfmVersion=$(RfmVersion)</DefineConstants>
    </PropertyGroup>
    <Message Importance="high" Text="$(MSBuildProjectName): RFM version $(RfmVersion)" />

    <MakeDir Condition="'$(MSBuildProjectExtension)' == '.csproj'" Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile Condition="'$(MSBuildProjectExtension)' == '.csproj'" File="$(RfmVersionFile)"
                      Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated by Version.targets;[assembly: System.Reflection.AssemblyVersion(&quot;$(RfmVersion).0&quot;)];[assembly: System.Reflection.AssemblyFileVersion(&quot;$(RfmVersion).0&quot;)]" />
    <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
      <Compile Include="$(RfmVersionFile)" />
      <FileWrites Include="$(RfmVersionFile)" />
    </ItemGroup>
  </Target>
</Project>
