# ==============================================================================
# Modular File Manager - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure with your actual values
# SECURITY: Never commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection URL for async operations
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://filemanager:changeme@localhost:5432/filemanager

# Database pool settings (optional - defaults shown)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ------------------------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------------------------
# Secret key for JWT token signing (HS256)
# CRITICAL: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_BYTE_STRING

# API server settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ------------------------------------------------------------------------------
# Security Settings
# ------------------------------------------------------------------------------
# TLS/SSL Configuration
TLS_ENABLED=true
TLS_CERT_PATH=/path/to/cert.pem
TLS_KEY_PATH=/path/to/key.pem
TLS_MIN_VERSION=1.3

# Session configuration
SESSION_LIFETIME_DAYS=30

# Admin credentials (only for initial setup - user managed in DB afterward)
# Password is hashed with Argon2 and stored in database
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123

# Admin Emergency Login (always functional, no DB dependency)
# CRITICAL: Use pre-hashed password for security
# Generate hash: python -c "from auth.utils import hash_password; print(hash_password('your_password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$kxMCoNQ6p1QqxTiHUGqNUQ$+yGg0YZMk3gqGZb5ZZWqJqHZ5C8xLBzN5sZq4gZQwWk

# ------------------------------------------------------------------------------
# Worker Configuration
# ------------------------------------------------------------------------------
# Worker authentication
WORKER_AUTH_PUBLIC_KEY_ALGO=RSA
WORKER_HEARTBEAT_INTERVAL=30
WORKER_HEARTBEAT_TIMEOUT=90

# ------------------------------------------------------------------------------
# External Integrations (Optional)
# ------------------------------------------------------------------------------
# Sybase Authentication API
ENABLE_SYBASE_AUTH=false
SYBASE_AUTH_URL=
SYBASE_AUTH_TIMEOUT=2
SYBASE_AUTH_STORED_PROC=

# Syslog Integration
ENABLE_SYSLOG=false
SYSLOG_HOST=
SYSLOG_PORT=514
SYSLOG_PROTOCOL=UDP

# Remote Audit API
ENABLE_REMOTE_AUDIT_API=false
REMOTE_AUDIT_API_URL=
REMOTE_AUDIT_API_TOKEN=
REMOTE_AUDIT_API_TIMEOUT=5

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_RETENTION_DAYS=14

# Structured logging
ENABLE_JSON_LOGS=true
ENABLE_FILE_LOGS=true
LOG_FILE_PATH=/var/log/file-manager/app.log

# Database logging
ENABLE_DATABASE_LOGS=true

# External API retries
EXTERNAL_API_RETRIES=3

# ------------------------------------------------------------------------------
# Redis Configuration (for session storage & caching)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
# Maximum concurrent authenticated users
MAX_CONCURRENT_USERS=4

# File operation settings
OPERATION_TIMEOUT=3600
ENABLE_AUTO_ROLLBACK=true
MAX_FILE_LISTING_ITEMS=1000

# Path prefixes (can be overridden per worker in DB)
GLOBAL_PATH_A_PREFIX=
GLOBAL_PATH_B_PREFIX=

# VF Redesign: Preset paths for PUSH/PULL operations
# PATH_B: Destination path for PUSH operations (admin-configurable)
# PATH_C: Archive path for PUSH operations (admin-configurable)
# IMPORTANT: These paths must be accessible by the worker
PATH_B=/path/to/destination
PATH_C=/path/to/archive

# ------------------------------------------------------------------------------
# Development / Testing
# ------------------------------------------------------------------------------
# Enable debug mode (NEVER in production!)
DEBUG=false

# Enable SQL query logging
SQL_ECHO=false

# Allow insecure connections (testing only)
ALLOW_INSECURE=false

# ------------------------------------------------------------------------------
# Docker-specific settings
# ------------------------------------------------------------------------------
# Used by docker-compose to configure PostgreSQL
POSTGRES_USER=filemanager
POSTGRES_PASSWORD=changeme
POSTGRES_DB=filemanager
POSTGRES_HOST=db
POSTGRES_PORT=5432
