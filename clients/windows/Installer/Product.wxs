<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="RFM Windows Integration"
           Language="1033"
           Version="1.0.0.0"
           Manufacturer="RFM"
           UpgradeCode="E6F7A8B9-C0D1-2345-EF01-234567890ABC">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="RFM Windows Context Menu Integration"
             Comments="Integrates RFM with Windows Explorer context menu" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Properties -->
    <Property Id="LANGUAGE_CHOICE" Value="en-US" />
    <Property Id="ARPPRODUCTICON" Value="RFMIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/your-org/rfm" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/your-org/rfm" />

    <!-- Configuration Properties (can be set via command line) -->
    <Property Id="API_URL" Value="https://rfm.company.com" />
    <Property Id="ALLOWED_PATHS" Value="C:\" />
    <Property Id="UI_LANGUAGE" Value="en-US" />
    <Property Id="CREDENTIAL_PREFIX" Value="RFM_ContextMenu" />

    <!-- Ensure .NET Framework 4.8 is installed -->
    <PropertyRef Id="WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED"/>
    <Condition Message="This application requires .NET Framework 4.8 or later. Please install the .NET Framework then run this installer again.">
      <![CDATA[Installed OR WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED]]>
    </Condition>

    <!-- Directory Structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="SystemFolder" />
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="RFM">

          <!-- Launcher Component -->
          <Component Id="LauncherComponent" Guid="F1A2B3C4-D5E6-7890-ABCD-EF1234567890">
            <!-- Main executable -->
            <File Id="RFMLauncher.exe"
                  Source="$(var.RFMLauncher.TargetPath)"
                  KeyPath="yes" />

            <!-- Configuration file (will be generated during install) -->
            <File Id="config.json"
                  Source="Files\config.json"
                  KeyPath="no" />

            <!-- NuGet dependencies -->
            <File Id="Newtonsoft.Json.dll"
                  Source="$(var.RFMLauncher.TargetDir)Newtonsoft.Json.dll" />

            <File Id="CredentialManagement.dll"
                  Source="$(var.RFMLauncher.TargetDir)CredentialManagement.dll" />

            <!-- JWT and Identity Model libraries -->
            <File Id="System.IdentityModel.Tokens.Jwt.dll"
                  Source="$(var.RFMLauncher.TargetDir)System.IdentityModel.Tokens.Jwt.dll" />

            <File Id="Microsoft.IdentityModel.Tokens.dll"
                  Source="$(var.RFMLauncher.TargetDir)Microsoft.IdentityModel.Tokens.dll" />

            <File Id="Microsoft.IdentityModel.Logging.dll"
                  Source="$(var.RFMLauncher.TargetDir)Microsoft.IdentityModel.Logging.dll" />

            <File Id="Microsoft.IdentityModel.JsonWebTokens.dll"
                  Source="$(var.RFMLauncher.TargetDir)Microsoft.IdentityModel.JsonWebTokens.dll" />
          </Component>

          <!-- Locales Directory -->
          <Directory Id="LocalesFolder" Name="locales">
            <Component Id="LocalesComponent" Guid="F2B3C4D5-E6F7-8901-ABCD-EF2345678901">
              <File Id="enUS.json"
                    Source="$(var.RFMLauncher.TargetDir)locales\en-US.json"
                    KeyPath="yes" />

              <File Id="plPL.json"
                    Source="$(var.RFMLauncher.TargetDir)locales\pl-PL.json" />
            </Component>
          </Directory>

          <!-- Shell Extension Component -->
          <Component Id="ShellExtComponent" Guid="A3B4C5D6-E7F8-9012-CDEF-123456789ABC">
            <File Id="RFMShellExt.dll"
                  Source="$(var.RFMShellExt.TargetPath)"
                  KeyPath="yes" />

            <!-- COM Class Registration -->
            <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{C3D4E5F6-A7B8-9012-CDEF-123456789ABC}" Type="string" Value="RFM Context Menu" />
            <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{C3D4E5F6-A7B8-9012-CDEF-123456789ABC}\InprocServer32" Type="string" Value="[#RFMShellExt.dll]" />
            <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{C3D4E5F6-A7B8-9012-CDEF-123456789ABC}\InprocServer32" Name="ThreadingModel" Type="string" Value="Apartment" />

            <!-- Context Menu Handlers -->
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\shellex\ContextMenuHandlers\RFM" Type="string" Value="{C3D4E5F6-A7B8-9012-CDEF-123456789ABC}" />
            <RegistryValue Root="HKLM" Key="Software\Classes\*\shellex\ContextMenuHandlers\RFM" Type="string" Value="{C3D4E5F6-A7B8-9012-CDEF-123456789ABC}" />
            <RegistryValue Root="HKLM" Key="Software\Classes\Folder\shellex\ContextMenuHandlers\RFM" Type="string" Value="{C3D4E5F6-A7B8-9012-CDEF-123456789ABC}" />

            <!-- Shell Extension Approval -->
            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved" Name="{C3D4E5F6-A7B8-9012-CDEF-123456789ABC}" Type="string" Value="RFM Context Menu" />
          </Component>

        </Directory>
      </Directory>

      <!-- Start Menu Folder -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="RFM">
          <Component Id="ApplicationShortcutComponent" Guid="B5C6D7E8-F9A0-1234-BCDE-F01234567890">
            <Shortcut Id="UninstallShortcut"
                      Name="Uninstall RFM Integration"
                      Target="[SystemFolder]msiexec.exe"
                      Arguments="/x [ProductCode]"
                      Description="Uninstalls RFM Windows Integration" />

            <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>

            <RegistryValue Root="HKCU"
                          Key="Software\RFM\Integration"
                          Name="installed"
                          Type="integer"
                          Value="1"
                          KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <!-- Features -->
    <Feature Id="ProductFeature" Title="RFM Windows Integration" Level="1">
      <ComponentRef Id="LauncherComponent" />
      <ComponentRef Id="LocalesComponent" />
      <ComponentRef Id="ShellExtComponent" />
      <ComponentRef Id="ApplicationShortcutComponent" />
    </Feature>

    <!-- User Interface -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <!-- Custom UI sequence to include configuration dialog -->
    <UI>
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="ConfigDialog" Order="3">LicenseAccepted = "1"</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="ConfigDialog">1</Publish>
    </UI>

    <!-- Custom Actions -->
    <Binary Id="GenerateConfigVbs" SourceFile="GenerateConfig.vbs" />

    <CustomAction Id="SetGenerateConfigData"
                  Property="GenerateConfigJson"
                  Value="[INSTALLFOLDER]|[API_URL]|[ALLOWED_PATHS]|[UI_LANGUAGE]|[CREDENTIAL_PREFIX]" />

    <CustomAction Id="GenerateConfigJson"
                  BinaryKey="GenerateConfigVbs"
                  VBScriptCall=""
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Register Shell Extension DLL using regsvr32 -->
    <CustomAction Id="SetRegisterShellExtPath"
                  Property="RegisterShellExt"
                  Value="&quot;[INSTALLFOLDER]RFMShellExt.dll&quot;" />

    <CustomAction Id="RegisterShellExt"
                  Directory="SystemFolder"
                  ExeCommand="regsvr32.exe /s [RegisterShellExt]"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="SetUnregisterShellExtPath"
                  Property="UnregisterShellExt"
                  Value="&quot;[INSTALLFOLDER]RFMShellExt.dll&quot;" />

    <CustomAction Id="UnregisterShellExt"
                  Directory="SystemFolder"
                  ExeCommand="regsvr32.exe /s /u [UnregisterShellExt]"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Install Sequence -->
    <InstallExecuteSequence>
      <Custom Action="SetGenerateConfigData" Before="GenerateConfigJson">
        NOT REMOVE
      </Custom>
      <Custom Action="GenerateConfigJson" After="InstallFiles">
        NOT REMOVE
      </Custom>

      <!-- Register Shell Extension DLL -->
      <Custom Action="SetRegisterShellExtPath" Before="RegisterShellExt">
        NOT REMOVE
      </Custom>
      <Custom Action="RegisterShellExt" After="GenerateConfigJson">
        NOT REMOVE
      </Custom>

      <!-- Unregister Shell Extension DLL on uninstall -->
      <Custom Action="SetUnregisterShellExtPath" Before="UnregisterShellExt">
        REMOVE="ALL"
      </Custom>
      <Custom Action="UnregisterShellExt" Before="RemoveFiles">
        REMOVE="ALL"
      </Custom>
    </InstallExecuteSequence>

    <!-- Prompt user to reboot after installation -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Please restart your computer for the context menu integration to take effect." />

    <!-- Localization -->
    <WixVariable Id="WixUILicenseRtf" Value="Files\License.rtf" />
  </Product>
</Wix>
