# ==============================================================================
# Modular File Manager - WebUI Dockerfile
# ==============================================================================
# Lightweight static file server with Flask proxy for API requests
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Builder - Install dependencies
# ------------------------------------------------------------------------------
ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim AS builder

# Build arguments
ARG BUILD_DATE
ARG VERSION=1.0.0

# Metadata
LABEL maintainer="File Manager Team"
LABEL version="${VERSION}"
LABEL description="WebUI frontend for Modular File Manager"
LABEL build-date="${BUILD_DATE}"

# Set environment variables for build
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=100

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Flask and minimal dependencies
RUN pip install --upgrade pip setuptools wheel && \
    pip install \
    flask==3.0.0 \
    gunicorn==21.2.0 \
    requests==2.31.0 \
    python-dotenv==1.0.0 \
    flask-cors==4.0.0

# ------------------------------------------------------------------------------
# Stage 2: Runtime - Create final image
# ------------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app:$PYTHONPATH"

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv

# Create application user (non-root for security)
RUN groupadd -r filemanager && \
    useradd -r -g filemanager -u 1001 -m -s /sbin/nologin filemanager

# Create application directories
RUN mkdir -p /app/frontend \
    /var/log/file-manager && \
    chown -R filemanager:filemanager /app \
    /var/log/file-manager

# Set working directory
WORKDIR /app

# Copy frontend static files
COPY --chown=filemanager:filemanager frontend/ /app/frontend/

# Copy Flask proxy server
COPY --chown=filemanager:filemanager webui/webui_server.py /app/webui_server.py
RUN chmod +x /app/webui_server.py

# Copy entrypoint script
COPY --chown=filemanager:filemanager webui/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Switch to non-root user
USER filemanager

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Set entrypoint
ENTRYPOINT ["/app/entrypoint.sh"]

# ==============================================================================
# Build Instructions:
# ==============================================================================
# docker build -f Dockerfile.webui -t file-manager-webui:latest .
# docker run -p 3000:3000 --env-file .env file-manager-webui:latest
# ==============================================================================
